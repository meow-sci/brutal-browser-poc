<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <!-- BRUTAL open-source packages (net10.0) -->
  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Core" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.BRUTAL.Numerics" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.BRUTAL.Maths" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.BRUTAL.Memory" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.BRUTAL.Collections" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.BRUTAL.Strings" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.BRUTAL.Logging" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Abstractions" Version="2026.10.2" />
  </ItemGroup>
</Project>
