<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop (macOS/MoltenVK) console app: source-built (patched) Brutal.Vulkan on its default native-loader path
       + the published NuGet Brutal.Vulkan.Abstractions. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(Exp04Root)src/Brutal.Vulkan/Brutal.Vulkan.csproj" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Abstractions" Version="$(BrutalVulkanVersion)" />
    <!-- Keep only the native asset (runtimes/osx-arm64/native/libVulkanEx.dylib) of Ahwoo.BRUTAL.Vulkan; drop its managed dll. -->
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan" Version="$(BrutalVulkanVersion)" ExcludeAssets="compile;runtime" />
  </ItemGroup>
</Project>
