<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    exp-04 browser-wasm check: source-built (patched) Brutal.Vulkan + NuGet Brutal.Vulkan.Abstractions, driven by the
    managed FakeIcd. Based on the .NET 10 `wasmbrowser` template (wwwroot/main.js is the host script; the template no
    longer uses WasmMainJSPath). No wasm-tools workload: the prebuilt runtime is used, no native relink.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>
  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(Exp04Root)shared/*.cs" Link="shared/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(Exp04Root)src/Brutal.Vulkan/Brutal.Vulkan.csproj" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Abstractions" Version="$(BrutalVulkanVersion)" />
    <!-- Drop the managed dll of the transitive Ahwoo.BRUTAL.Vulkan package (the native assets have no browser-wasm RID anyway). -->
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan" Version="$(BrutalVulkanVersion)" ExcludeAssets="compile;runtime" />
  </ItemGroup>
</Project>
