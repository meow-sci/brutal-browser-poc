<Project Sdk="Microsoft.NET.Sdk">
  <!-- exp-06 negative check: managed-flavor Brutal.Vulkan (source) + the PUBLISHED NuGet Brutal.Vulkan.Abstractions,
       which was compiled against the unmanaged function-pointer field types. Shows what breaks and how. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BrutalManagedFnptr>true</BrutalManagedFnptr>
    <DefineConstants>$(DefineConstants);BRUTAL_MANAGED_FNPTR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Exp06Root)shared/ManagedIcd.cs" Link="shared/ManagedIcd.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(Exp06Root)src/Brutal.Vulkan/Brutal.Vulkan.csproj" AdditionalProperties="BrutalManagedFnptr=true" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Abstractions" Version="$(BrutalVulkanVersion)" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan" Version="$(BrutalVulkanVersion)" ExcludeAssets="compile;runtime" />
  </ItemGroup>
</Project>
