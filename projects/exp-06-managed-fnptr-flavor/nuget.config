<?xml version="1.0" encoding="utf-8"?>
<!-- Local feed config for exp-06: only nuget.org (the user-level config also lists a private GitHub feed we do not need). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
