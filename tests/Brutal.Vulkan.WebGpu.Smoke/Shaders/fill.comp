#version 450
// Web ICD smoke test: a compute dispatch writing a storage buffer (data[i] = i * 3 + push.bias).
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Out { uint data[]; } outBuf;
layout(push_constant) uniform Push { uint bias; } pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    outBuf.data[i] = i * 3u + pc.bias;
}
