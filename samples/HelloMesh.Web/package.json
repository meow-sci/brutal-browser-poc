{
  "name": "hellomesh-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Vite 8 host for the HelloMesh browser build (.NET wasm + WebGPU): serves the .NET wwwroot, boots the runtime, drives the frame loop.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:dotnet": "node scripts/build-dotnet.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:e2e:chrome": "node test/e2e.mjs --chrome"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@webgpu/types": "0.1.74",
    "playwright-core": "1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "8.3.4"
  }
}
